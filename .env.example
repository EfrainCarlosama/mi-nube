# Mi Nube - configuración local de desarrollo
MI_NUBE_ENV=development
MI_NUBE_LOG_LEVEL=INFO

# Registro público de escritorio en Microsoft Entra ID. No agregue secretos.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# Canal HTTPS opcional para buscar actualizaciones firmadas.
MI_NUBE_UPDATE_URL=
